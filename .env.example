# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8787
LOG_LEVEL=INFO
TRADING_HELPER_DB=data/trading_helper.db
SETTINGS_FILE=config/settings.yaml

# Interactive Brokers
# IB Gateway defaults: Paper 4002, Live 4001
# TWS defaults: Paper 7497, Live 7496
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=17
IBKR_PAPER_TRADING=true
IBKR_READ_ONLY=true

# Notifications
NTFY_ENABLED=false
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=replace-with-a-long-random-private-topic
