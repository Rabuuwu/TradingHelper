# Application
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8787
LOG_LEVEL=INFO
TRADING_HELPER_DB=data/trading_helper.db
SETTINGS_FILE=config/settings.yaml

# Market data. "sample" works offline and requires no broker or API key.
MARKET_DATA_PROVIDER=sample
MARKET_DATA_API_KEY=
# Optional for feeds known to be delayed; e.g. 15. Leave empty if unknown/live.
MARKET_DATA_DELAY_MINUTES=

# Optional single-user authentication for remote/private-network access.
AUTH_ENABLED=false
AUTH_USERNAME=trader
AUTH_PASSWORD_HASH=
SESSION_SECRET=replace-with-a-long-random-secret

# Optional desktop client (configured on the client computer, not the server).
TRADING_HELPER_SERVER_URL=http://127.0.0.1:8787

# Notifications
NTFY_ENABLED=false
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=replace-with-a-long-random-private-topic
