[Unit]
Description=TradingHelper local API and scanner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=CHANGE_ME
WorkingDirectory=/home/CHANGE_ME/TradingHelper
EnvironmentFile=/home/CHANGE_ME/TradingHelper/.env
ExecStart=/home/CHANGE_ME/TradingHelper/.venv/bin/python -m trading_helper.main api
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
